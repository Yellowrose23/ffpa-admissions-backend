# Copy this file to .env and fill in real values.
# .env is where secrets live — never commit it to a public repo.

# Port the server listens on (most hosts set this for you automatically)
PORT=3001

# A long, random string only you know. Used to protect the
# GET /api/applications endpoint. Change this before deploying.
ADMIN_KEY=replace-with-a-long-random-string

# --- Email notifications ---
# Leave these blank to run in "dev mode" (emails are logged to the console
# instead of sent — useful for testing before you have real credentials).
# To send real emails, fill these in with your email provider's SMTP details
# (Gmail, Outlook, SendGrid, Mailgun, etc. all provide these).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=admissions@ffpacademy.org
FROM_EMAIL=no-reply@ffpacademy.org
